# Secrets and local identity -- never commit
.env

# Transient files from a single wave
.wave.json
wave.json

__pycache__/
*.py[cod]
.DS_Store

# Note: medspa/candidates.csv, medspa/enriched.csv, medspa/.query_progress and
# outreach/*.csv (including scrape_log.csv) ARE committed on purpose. They are
# this agent's entire memory -- who has been found, who has been emailed, who
# replied, and where the daily discovery sweep left off. A fresh container
# with an empty sent_log will happily email everyone a second time, and one
# with no .query_progress will restart the sweep at the first city.
