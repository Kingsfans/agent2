# Copy this file to .env and fill it in. .env is gitignored and never committed.
#
#   cp .env.example .env
#
# Nothing here is a password for sending. Email goes out through the Gmail
# connector in Claude, which you authorize once in your own Claude account.

# --- Who the emails come from (REQUIRED) -------------------------------------
# The engine refuses to build a wave until both of these are set. Use your own
# name and your own work mailbox -- these emails send as you.
SENDER_NAME=
SENDER_EMAIL=

# --- Mailbox access for the bot (REQUIRED to draft or send) -------------------
# The bot drafts and sends through plain IMAP/SMTP, so it needs one app
# password for the mailbox above. This is NOT your Google account password:
#   1. Turn on 2-Step Verification on that Google account
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters here (spaces are fine)
# Verify it without sending anything:  python3 emailer/mailbox.py
GMAIL_APP_PASSWORD=

# Only needed for a non-Gmail mailbox.
#IMAP_HOST=imap.gmail.com
#IMAP_PORT=993
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#IMAP_DRAFTS_FOLDER=[Gmail]/Drafts

# Seconds between messages inside a wave, so a batch doesn't leave as a burst.
SEND_DELAY_SECONDS=6

# Company facts are fixed in code (Marinexis Biologics, 6671 S Las Vegas Blvd,
# Las Vegas, NV 89118) and appear in the CAN-SPAM footer of every message.

# --- Pacing -------------------------------------------------------------------
# A new mailbox gets throttled if it ramps too fast. Start at 20 for the first
# few days, then 50, then 100. Do not go above 100.
DAILY_CAP=20
HOURLY_CAP=10

# Follow-up cadence: one every N days, this many times, then stop.
FOLLOWUP_DAYS=3
MAX_FOLLOWUPS=3
# Ceiling on how much of a wave can be follow-ups rather than new prospects.
FU_SHARE=0.5

# Your timezone, so the daily cap resets at your local midnight.
LOCAL_TZ=America/Los_Angeles

# --- Lead discovery (all optional) -------------------------------------------
# With one of these, `medspa/discover.py run` searches by itself. With none,
# Claude does the searching with its own web search tool instead -- which works
# fine, just slower. Pick at most one; Serper is the easiest to get.
#
# https://serper.dev/
SERPER_API_KEY=
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# https://programmablesearchengine.google.com/ + a Google Cloud API key
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# --- Crawler etiquette --------------------------------------------------------
# Identify the crawler honestly, with a real contact address, so a site owner
# who objects can reach you.
SCRAPER_USER_AGENT=MarinexisLeadBot/1.0 (+contact: your-email@marinexisbiologics.com)
REQUEST_TIMEOUT_SECONDS=15
# Pause between sites during enrichment, so a run of hundreds of crawls doesn't
# look like a hammering script to any one host. enrich.py also checks each
# site's robots.txt before fetching.
CRAWL_DELAY_SECONDS=0.5

# --- Daily scraping (daily_scrape.py) ------------------------------------------
# Minimum number of med spa sites to discover + crawl each day. This is
# DISCOVERY volume only -- it has nothing to do with DAILY_CAP above, which
# governs outbound email and stays capped for mailbox safety regardless of how
# big the queue gets.
DAILY_SCRAPE_TARGET=500
# Ceiling on search-API queries per day, so hitting the scrape target can't run
# away into an unexpectedly large API bill. Each query returns up to ~20
# candidate sites, so 150 queries comfortably covers a 500-site target even
# after dedup.
MAX_QUERIES_PER_DAY=150
